# CAMPUSLINK Django Environment Variables
# Copy this file to .env and populate with actual values for your environment.
# DO NOT COMMIT .env to version control.

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================

# Set to 'false' in production
DEBUG=true

# Required for production. Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-do-not-use-in-production

# Comma-separated list of allowed hostnames (e.g., "example.com,www.example.com")
# Required when DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,127.0.0.1:8000

# =============================================================================
# HTTPS AND SECURITY
# =============================================================================

# Enable HTTPS redirect in production
SECURE_SSL_REDIRECT=false

# Comma-separated list of trusted origins for CSRF (include scheme)
# Example: "https://example.com,https://www.example.com"
CSRF_TRUSTED_ORIGINS=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Optional: Connection URL for PostgreSQL or other supported Django database
# Format: postgresql://user:password@host:port/dbname
# If not set, SQLite (CAMPUSLINK/db.sqlite3) is used locally
# DATABASE_URL=

# =============================================================================
# DEPLOYMENT-SPECIFIC (for Render.com or similar platforms)
# =============================================================================

# Automatically set by Render and other platforms; generally not needed locally
# RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# Email backend: console (default, prints to stdout) or smtp
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP configuration (only if using SMTP backend)
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=your-email@example.com
# DJANGO_EMAIL_HOST_PASSWORD=your-app-password
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_EMAIL_USE_SSL=false

# =============================================================================
# LEGACY/ALTERNATIVE ENVIRONMENT VARIABLE NAMES
# =============================================================================

# These alternative names are also accepted for backward compatibility:
# DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=your-secret-key-here
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECURE_SSL_REDIRECT=false
